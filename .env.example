# Supabase (Project Settings -> API). Service role key stays server-side only.
SUPABASE_URL=https://xxxx.supabase.co
SUPABASE_SERVICE_ROLE_KEY=

# Resend. RESEND_FROM must be on a domain verified in Resend.
RESEND_API_KEY=
RESEND_FROM="andi <andi@yourdomain.com>"

# Public
NEXT_PUBLIC_STRIPE_LINK=https://buy.stripe.com/xxxx
NEXT_PUBLIC_X_HANDLE=lameda12
# Optional: canonical URL for OG tags. Falls back to Vercel's production URL.
NEXT_PUBLIC_SITE_URL=
